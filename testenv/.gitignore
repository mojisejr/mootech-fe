# self-signed certs are generated at container start — never commit
certs/
# a real .env should never live here; only the committable *.env templates in env/ do
*.env.local
.env

# prod dumps — NEVER commit. Phase 2 full.sql = REAL customer data across all 149 tables (dob, names,
# phones). gitleaks won't catch it (it hunts keys/tokens, not birthdates). One `git add .` = PII in
# git history forever. Scope to dumps/ only — scripts/anonymize.sql is a committable script, not data.
dumps/
*.sql.gz

# .env backups hold PROD credentials — stack.sh writes them here (out of every app repo, where
# .env.prod.bak would NOT be gitignored and could be committed).
.backups/

# log ของ line-stub (stack.sh up เขียนไว้) — เป็นของชั่วคราวประจำเครื่อง ไม่ใช่ของโปรเจกต์
# ข้างในมี LINE userId ของคนที่ล็อกอินบนสนาม ⇒ ไม่ควรขึ้น git แม้จะไม่ใช่ความลับระดับคีย์
.line-stub.log
