# mootech-fe — LOCAL test-env. COMMITTABLE (no real secrets). stack.sh copies → mootech-fe/.env (backs up first).
# comments live on their OWN line — a trailing "# ..." after a value trips bash tools that grep the value.
# so pages/dev-login.tsx is enabled (gated NODE_ENV!==production)
NODE_ENV=development
# drizzle ssl:'require' → talks to the SSL postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mumate_test
# mootech-be (User/ChineseHoroscope/Analytic/Mascot)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# bazi (/api/home persona+fortune)
BAZI_BASE_URL=http://localhost:3100
# team gate passkey (simple local value)
V2_PREVIEW_KEY=local-testenv
NEXTAUTH_URL=http://localhost:3000
# dummy — dev-login bypasses OAuth
NEXTAUTH_SECRET=local-testenv-nextauth-secret
