# mootech-be — LOCAL test-env (dummy externals, real-local DB). COMMITTABLE: no real secrets.
# stack.sh copies this → mootech-be/.env (BE loads `.env`, NOT `.env.test` — no envFilePath configured).
# stack.sh BACKS UP the existing mootech-be/.env first (it holds prod cred) before overwriting.

# --- DATABASE (real-local; SSL served by the compose postgres — see docker-compose WHY) ---
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=mumate_test
# MUST be false — schema is restored from the prod dump, not synced
DB_SYNCHRONIZE=false

# --- BOOT-CRITICAL dummy (wrong-shaped → boot crash) ---
# object-storage.service.ts:30 onModuleInit → createClient() validates the URL synchronously.
# MUST be a valid https URL
SUPABASE_PROJECT_URL=https://dummy.supabase.co
# MUST be non-empty
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key
SUPABASE_STORAGE_BUCKET=mumate
SUPABASE_SIGNED_URL_TIMEOUT=3600

# --- APP / PORT (default is 3000 which COLLIDES with FE → force 4000) ---
ENVIRONMENT=development
APP_PORT=4000
PORT=4000
CORS_ORIGINS=http://localhost:3000
MIGRATION_ENABLED=false
# keep cron off locally
MORNING_CRON_ENABLED=false

# --- DUMMY external services (lazy — fail only if the feature is invoked, which v2 UI dev never does) ---
OMISE_PUBLIC_KEY=pkey_test_dummy
OMISE_SECRET_KEY=skey_test_dummy
OMISE_RETURN_URI=http://localhost:3000/payment/callback
OMISE_WEBHOOK_SECRET=dummy_webhook_secret
LINE_HOST=https://api.line.me
LINE_TOKEN=dummy_line_token
SENDGRID_API_KEY=SG.dummy
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=MuMate
SMS_8X8_HOST=https://sms.8x8.com
SMS_8X8_TOKEN=dummy_sms_token
SMS_8X8_TOPIC=dummy_topic
SMS_8X8_ENCODING=AUTO
DIFY_API_URL=https://dify.example.com/v1
DIFY_API_KEY=dummy_dify_key
AI_CONSUME_SECRET=dummy_ai_secret
AWS_ACCESS_KEY_ID=dummy_aws_key
AWS_SECRET_ACCESS_KEY=dummy_aws_secret
AWS_S3_ROOT_BUCKET=dummy-bucket
AWS_S3_THUMB_ROOT_BUCKET=dummy-thumb
AWS_S3_SIGNED_URL_TIMEOUT=3600
