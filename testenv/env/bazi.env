# bazi (bazi-sft-dataset) — LOCAL test-env. Named bazi.env (NOT .env.test — bazi/.gitignore:30 ignores that).
# stack.sh copies this → bazi-sft-dataset/.env.local (backs up existing first).
# APP_DATABASE_URL is checked FIRST by getDatabaseUrl (env.ts:49: APP_DATABASE_URL ?? DATABASE_URL) →
# point it at local so bazi uses the test DB regardless of any leftover DATABASE_URL. client.ts ssl:'require'.
APP_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mumate_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mumate_test
# Clerk keys are .optional() in env.ts + no middleware.ts → dummy is fine (routes /api/home, public-calc are open)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dummy
CLERK_SECRET_KEY=sk_test_dummy
# Supabase Storage (divine-cards) — dummy; v2 UI dev doesn't hit storage routes
# .invalid ไม่ใช่ .co (#231): supabase.co เป็นโดเมนจริงที่ resolve ได้ ⇒ ถ้า bazi เผลอยิง storage route
# คำขอจะออกเน็ตจริง · .invalid (RFC-2606) ตันแน่นอน และตรงกับที่ be.env ใช้อยู่แล้ว
# guard เพิ่งเห็นบรรทัดนี้เป็นครั้งแรกเมื่อ SUPABASE_URL ถูกเพิ่มเข้า DB_KEYS — ก่อนหน้านั้นไม่มีใครเฝ้า
SUPABASE_URL=https://dummy.supabase.invalid
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key
SUPABASE_DIVINE_BUCKET=divine-cards
