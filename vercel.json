{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/push-reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/reconcile-payment",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/manifest-morning",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "pages/api/cron/push-reminders.ts": {
      "maxDuration": 60
    },
    "pages/api/cron/reconcile-payment.ts": {
      "maxDuration": 60
    },
    "pages/api/cron/manifest-morning.ts": {
      "maxDuration": 60
    }
  }
}
