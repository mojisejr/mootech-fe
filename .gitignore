# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.disabled
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright (e2e)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.playwright-mcp/

# generated harness evidence
harness/evidence/

# design-review captures — binaries + PII-shaped; reproduce via harness/archive/capture-route.ts
# (archived 2026-08-18 · mootech-fe#321 — the dir stays here because that is where the tool writes), don't commit
harness/captures/

# raw image sources — ฟีม drops originals here; `npm run assets:optimize` writes the committed .webp to public/
# ignore the raw images themselves, but KEEP the README so the dir + how-to is tracked
assets-src/*
!assets-src/README.md

# test-env secrets (passkey etc.) — never commit
testenv/env/*.env

# first-frame / shift evidence — a screencast run writes hundreds of PNGs (~350MB per run). The NUMBERS
# are the evidence and they live in the PR body; the frames are reproducible with the command beside them.
# (harness/out itself still tracks the small curated shots earlier PRs committed.)
# ONE ignored root for every run dump. The first version of this listed dirs by name and the very next
# card's runs (--out ctl-nav, p4-normal, exp-400 …) walked straight past it — a rule that has to be
# updated every time it is used is a rule that will be forgotten exactly once. The harnesses now default
# their --out under here, so a new run name cannot leak 350MB into a commit.
harness/out/_frames/

# Serwist PWA build output (#285) — regenerated by `next build`, never commit
public/sw.js
public/sw.js.map
public/swe-worker-*.js
