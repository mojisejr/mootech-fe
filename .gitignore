# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.disabled
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright (e2e)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.playwright-mcp/

# generated harness evidence
harness/evidence/

# design-review captures — binaries + PII-shaped; reproduce via harness/capture-route.ts, don't commit
harness/captures/

# raw image sources — ฟีม drops originals here; `npm run assets:optimize` writes the committed .webp to public/
# ignore the raw images themselves, but KEEP the README so the dir + how-to is tracked
assets-src/*
!assets-src/README.md

# test-env secrets (passkey etc.) — never commit
testenv/env/*.env

# first-frame / shift evidence — a screencast run writes hundreds of PNGs (~350MB per run). The NUMBERS
# are the evidence and they live in the PR body; the frames are reproducible with the command beside them.
# (harness/out itself still tracks the small curated shots earlier PRs committed.)
harness/out/first-frame/
harness/out/ff-*/
harness/out/p1/
harness/out/p1-verify/
