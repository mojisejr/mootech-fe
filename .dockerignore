# Nothing that holds a credential or machine-local state may enter the build context. Every env spelling,
# including the arena's shadow copies (testenv/scripts/stack.sh renames the real .env* to *.testenv-shadowed).
.env
.env.*
!.env.example
*.testenv-shadowed
.env.disabled
testenv/env/*.env
testenv/.backups
testenv/dumps
testenv/certs
# Produced inside the image.
node_modules
.next
out
coverage
test-results
playwright-report
tsconfig.tsbuildinfo
*.log
# WebP twins of public/images (scripts/webp-siblings.ts runs in the builder; a dev machine's copies stay out)
public/images/**/*.png.webp
public/images/**/*.jpg.webp
public/images/**/*.jpeg.webp
public/images/**/*.PNG.webp
public/images/**/*.JPG.webp
public/images/**/*.JPEG.webp
# Repository plumbing, evidence and tooling the server never reads at runtime.
.git
.github
.githooks
.vercel
.DS_Store
docs
e2e
harness
assets-src
*.md
