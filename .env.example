# mootech-fe environment — copy to .env and fill in. NEVER commit .env.
# Keys below are the vars the app actually reads (process.env.*).

# --- App ---
ENVIRONMENT=
NODE_ENV=

# --- Backend / services ---
# NEXT_PUBLIC_BACKEND_URL must point at OUR NestJS (Render), never old prod.
# Guardrail in constants/api/endpoint.ts throws if it resolves to old prod.
NEXT_PUBLIC_BACKEND_URL=
BAZI_BASE_URL=
DATABASE_URL=
OPEN_WEBUI_API_TOKEN=

# --- NextAuth ---
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# --- OAuth providers ---
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
IG_CLIENT_ID=
IG_CLIENT_SECRET=
IG_REDIRECT_URI=

# --- Payment (Omise) ---
NEXT_PUBLIC_OMISE_KEY=
OMISE_PUBLIC_KEY=

# --- Legacy (unused; do not point at old prod) ---
HOST=
