# mootech-fe environment — copy to .env and fill in. NEVER commit .env.
# Keys below are the vars the app actually reads (process.env.*).

# --- App ---
ENVIRONMENT=
NODE_ENV=

# --- Backend / services ---
# NEXT_PUBLIC_BACKEND_URL must point at OUR NestJS (Render), never old prod.
# Guardrail in constants/api/endpoint.ts throws if it resolves to old prod.
NEXT_PUBLIC_BACKEND_URL=
BAZI_BASE_URL=
# Timeout for the ดวงสมพงษ์ pair-match call (#357). Optional — omit for the 12000ms default.
BAZI_PAIR_TIMEOUT_MS=
# Timeout for the ดูดวงเพื่อนร่วมงาน call (#585). Optional — omit for the 20000ms default.
# 🔴 SEPARATE FROM THE PAIR NUMBER ON PURPOSE: that call runs 1 chart, this one runs up to 3 and was
# measured at 8.4s. One shared value means the next person tuning the fast lane silently breaks this one.
BAZI_WORK_TIMEOUT_MS=
DATABASE_URL=
OPEN_WEBUI_API_TOKEN=

# --- Glass Box console (#bazi-chat-anti-drift v2) ---
# ซินแส trace console at /glass-box. Open `?key=<GLASS_BOX_KEY>` once to set the gb_access cookie.
# Locked independent of maintenance; UNSET = the console does not exist (fail closed). Never commit a real value.
GLASS_BOX_KEY=

# --- Ops Dashboard (#mumate-ops-dashboard-phase1) ---
# Internal-only /ops. Shared passkey -> httpOnly cookie, mirrors GLASS_BOX_KEY above.
# UNSET OPS_DASHBOARD_KEY = the whole /ops surface is hidden (fail closed). Never commit real values.
OPS_DASHBOARD_KEY=

# Team-only MuMate v2 preview at /v2. Shared passkey -> httpOnly v2_access cookie (POST /api/v2/login).
# UNSET V2_PREVIEW_KEY = the whole /v2 surface is hidden (fail closed). Never commit real values.
V2_PREVIEW_KEY=
RENDER_API_KEY=
VERCEL_TOKEN=
GITHUB_TOKEN=
DASHBOARD_DISCORD_WEBHOOK=

# --- Public Bazi Calculator (#public-bazi-calculator) ---
# /calculator — no login, free, unlimited. CALC_NONCE_SECRET signs the page-issued nonce
# cookie (lib/calculator/nonce.ts) that guards the compute API against direct scripted POSTs.
# REQUIRED before deploy: unset = both the page (getServerSideProps) and the compute API throw
# (fail closed by design — no silent "nonce check disabled" mode). CALC_RATE_PER_MIN is optional,
# defaults to 10 req/min per IP.
CALC_NONCE_SECRET=
CALC_RATE_PER_MIN=

# --- NextAuth ---
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# --- OAuth providers ---
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
IG_CLIENT_ID=
IG_CLIENT_SECRET=
IG_REDIRECT_URI=

# --- Payment (Omise) ---
NEXT_PUBLIC_OMISE_KEY=
OMISE_PUBLIC_KEY=

# --- Legacy (unused; do not point at old prod) ---
HOST=

# PWA web-push (#285). Generate a VAPID keypair (npx web-push generate-vapid-keys).
# PUBLIC key is safe to expose in the client bundle. PRIVATE key is server-only (phase 3/4) —
# set it as a NON-public env (VAPID_PRIVATE_KEY) and NEVER prefix it NEXT_PUBLIC_.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# #403 — vars the app reads that this file never declared.
# None of them is a security hole: every one fails CLOSED. The cost is that the
# error a missing var produces NAMES THE WRONG CAUSE, so whoever hits it goes
# hunting the wrong bug. That is why each line below says what you will see.
# Enforced by scripts/env-example-drift.test.ts (scope: lib/ pages/ features/).
# ─────────────────────────────────────────────────────────────────────────────

# --- Omise / payment (money lane) ---
# unset -> lib/payment/omise-gateway.ts throws "OMISE_SECRET_KEY is not configured" (this one names itself)
OMISE_SECRET_KEY=
# unset -> verifyWebhook() returns false -> /api/v2/payment/webhook answers 401 "invalid signature".
#          Looks like an HMAC/signature bug. It is not. It is this line.
OMISE_WEBHOOK_SECRET=
# unset -> lib/payment/webhook-endpoint.ts throws WebhookEndpointConfigError and the charge is REFUSED
#          before any money moves (#374). Deliberately fatal: without it Omise delivers this charge's
#          events to the ACCOUNT's static webhook, which belongs to v1 -> money moves, nobody provisioned.
#          Must be https, and not localhost / an IP / an all-digit host (Omise rejects those).
OMISE_WEBHOOK_URL_V2=
# optional: PromptPay-only return URL now (#439 moved the CARD lane off this one). Unset -> not sent.
# 🔴 NOT the card lane. Setting this does nothing for card 3-D Secure — see OMISE_RETURN_ORIGIN_V2 below.
OMISE_RETURN_URI=
# 🔴 #439 — the ORIGIN (scheme + host, no path) the cardholder is sent back to after 3-D Secure. The full
#    return_uri is built PER CHARGE from it (lib/payment/return-uri.ts), because the customer must come back
#    to the result screen for THEIR order — a single static URL cannot do that.
#    Unset -> no return_uri is sent at all, i.e. exactly the pre-#439 behaviour. That is what makes it safe
#    to deploy the code before this variable exists; the reverse order is NOT safe (Omise would start
#    returning authorize_uri to a build that cannot use it, and charges would hang instead of failing).
#    Must be https, and not localhost / an IP: a BANK redirects the CUSTOMER'S browser, not this machine.
#    Real symptom when absent while the Omise account has 3DS on (2026-08-25, chrg_test_68sqyiewk273amg304u):
#      failure_code "payment_rejected" · failure_message "3d secure is requested but return_uri is not set"
OMISE_RETURN_ORIGIN_V2=
# unset -> features/v2-shop/omise-token.ts throws OmiseKeyMissingError and the /v2 card screen refuses to
#          tokenize. Deliberately NO fallback to NEXT_PUBLIC_OMISE_KEY: that is v1's LIVE key, and
#          borrowing it would let a test-key swap break v1's real payments silently.
#          This line was MISSING until 2026-08-25. The guard could not see the read because the file
#          reaches it through an alias (`env[V2_OMISE_KEY_ENV]`) - the same blind spot too found on
#          OMISE_WEBHOOK_URL_V2 in PR #425. Widening envReadsIn to resolve aliases surfaced this one.
#          WHERE TO GET ONE (mootech-fe#482): Omise Dashboard -> Settings -> Keys -> Public key, with the
#          dashboard in TEST mode. It starts with `pkey_test_`. Ask Feem if you do not have access.
#          It is only needed to exercise the /v2 card lane on your machine: `npm run build` is green
#          WITHOUT it, because scripts/check-omise-key-inlined.sh skips (loudly) on a local build.
#          ⚠️ Do NOT copy the value out of testenv/env/fe.env. That one is `pkey_test_localtestenv`,
#          a dummy long enough to satisfy the build gate but not a credential Omise will accept, so a
#          card payment fails at tokenisation with no hint that the key was the reason.
#          Never put the live key here, and never commit any key to this file.
NEXT_PUBLIC_OMISE_KEY_V2=

# --- BFF -> BE shared secrets ---
# unset -> the BFF sends an EMPTY x-consent-secret and the BE 401s. Looks like BE auth is broken.
CONSENT_SECRET=
# unset -> isAuthorized() returns false for every caller -> /api/cron/push-reminders 401s.
#          Fails closed correctly; looks like the cron caller lost its credentials.
CRON_SECRET=
# unset -> the AI wallet call goes out without x-ai-secret and is rejected upstream.
AI_CONSUME_SECRET=

# --- Web push (#285) ---
# unset -> lib/push/send.ts throws before sending. Pairs with NEXT_PUBLIC_VAPID_PUBLIC_KEY above.
VAPID_SUBJECT=
VAPID_PRIVATE_KEY=

# --- bazi / chat rollout flags ---
BAZI_WHATIF_URL=
BAZI_CHAT_PUBLIC=
BAZI_CHAT_TESTERS=
NEXT_PUBLIC_ENABLE_CHAT=

# --- credit ---
# unset -> credit enforcement stays off; the app runs, it just does not charge credits.
CREDIT_ENFORCE=

# ── #409 · the reconciler's kill switch ──────────────────────────────────────────────────────────────
# Turns OFF the payment reconciler cron (/api/cron/reconcile-payment) WITHOUT touching push-reminders —
# they share one project-level CRON_SECRET, so removing that would switch both off at once.
# unset (or anything unrecognised) -> the reconciler RUNS. Deliberate: this switch turns off a REPAIR job,
#   and "off by default" would mean a customer who paid and lost their webhook stays ungranted, silently.
#   The ACCESS gate is CRON_SECRET and that one still fails closed.
# set to off|false|0|no|disabled -> the cron answers 200 and does nothing, and says so in the log every
#   run ("SKIPPED — RECONCILE_ENABLED is set to off"). Being switched off is never silent.
# ⚠️ env vars bind to a Vercel deployment: changing this needs a Redeploy to take effect (no code change,
#   no PR, no review). A switch that needs nothing at all is the app_setting move tracked in #410.
RECONCILE_ENABLED=

# ซื้อชี่ (buy-qi): secret เดียวกับ engine (bazi-pdf-dev) — engine ใช้ป้องกัน /api/qi/grant
QI_GRANT_SECRET=must-match-engine-QI_GRANT_SECRET
