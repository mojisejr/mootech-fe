#!/usr/bin/env bash
# pre-push — TWO guards, deliberately with DIFFERENT failure directions (see §fail direction below).
#
#   guard A (branch)  refuse an ACCIDENTAL push straight to this repo's protected (default) branch.
#   guard B (gate)    refuse a push whose `lint` or `test` is not green on THIS machine.  (#320)
#
# The protected branch is READ FROM GIT, never hardcoded: mootech-fe → main, bazi → pdf-dev, etc.
# (from the remote's HEAD symref). So the same hook is correct in every repo.
#
# HONEST SCOPE: this catches "เผลอ push main" and "เผลอ push ของที่ยังไม่เขียว". It is NOT a hard block —
# `git push --no-verify` skips every hook. It is the "ดัก" layer, not "บังคับ" (we have no enforced layer;
# GitHub Pro was declined). The PR/merge rules still matter precisely because this can be bypassed.
#
# WHY THE GATE LIVES HERE AND NOT IN CI (#318, ฟีม-decided 2026-08-18):
#   `ci.yml` is being retired — merge into main = production deploy, and GitHub Actions minutes are paid.
#   So build/lint/test move onto the developer's machine. `lint` + `test` run here on every push
#   (mootech-fe ≈ 30s · mootech-be ≈ 112s, measured 2026-08-18). `build` deliberately does NOT:
#   it costs 4m11s on mootech-fe and a normal issue takes 4-5 pushes ⇒ ~21 min of repeated build ⇒ people
#   would reach for `--no-verify`, and that would take lint AND test down with it. `build` is checked once
#   before opening the PR instead, with its output pasted into the PR body.
#
#   ⚠️ THE REASON IS THE VARIANCE, NOT THE AVERAGE. Five runs on the same commit, 2026-08-18:
#       41s · 71s · 134s · 251s · 408s   — a 10× spread depending on what `.next/` happens to hold.
#     Anyone who just ran `npm ci`, or switched between distant branches, pays the 400s end. So the honest
#     statement is not "build is slow", it is "build's cost is UNPREDICTABLE" — and an unpredictable wait
#     in front of every push is what teaches people to reach for `--no-verify`. lint+test are ~30s and
#     barely move; that stability is why they can live here and build cannot.
#
# git invokes: pre-push <remote-name> <remote-url>, with stdin lines:
#   <local ref> SP <local oid> SP <remote ref> SP <remote oid> LF
set -euo pipefail

remote="${1:-origin}"
ZERO_OID_RE='^0*$'

# ── guard A · protected branch ────────────────────────────────────────────────────────────────
# protected branch = the remote's default branch, from git (not hardcoded).
protected="$(git symbolic-ref --quiet --short "refs/remotes/${remote}/HEAD" 2>/dev/null | sed "s#^${remote}/##" || true)"
if [ -z "${protected}" ]; then
  # Detection failed → guard A FAILS OPEN (a ดัก must not block legit work when it can't tell).
  # 🔴 It must NOT `exit 0` here. That returns from the whole script and takes guard B — which fails
  #    CLOSED on purpose — down with it. ตู๋ proved it (#325, 2026-08-18): with origin/HEAD removed and
  #    lint red, the push SUCCEEDED and the hard gate never ran, while the message said "guard skipped"
  #    (singular) — so the §fail direction paragraph below was describing something the code did not do.
  #    Leaving `protected` empty and guarding the comparison skips ONLY guard A.
  echo "pre-push: cannot determine ${remote}'s default branch (is ${remote}/HEAD set?) — branch guard skipped (the lint/test gate still runs)." >&2
fi

blocked=0
# has_content = at least one ref actually SENDS commits up. Verified empirically 2026-08-18 in a throwaway
# repo, because guessing this wrong wastes 30-112s on pushes that carry no code:
#   push a branch   → localref='refs/heads/feat/x'  localoid=<sha>
#   push --delete   → localref='(delete)'           localoid=000…0     ⇒ skip the gate
#   already up-to-date → git fires the hook with ZERO stdin lines      ⇒ skip the gate
has_content=0
while read -r _localref localoid remoteref _remoteoid; do
  [ -z "${remoteref:-}" ] && continue
  if ! [[ "${localoid}" =~ ${ZERO_OID_RE} ]]; then
    has_content=1
  fi
  branch="${remoteref#refs/heads/}"
  if [ -n "${protected}" ] && [ "${branch}" = "${protected}" ]; then
    blocked=1
  fi
done

if [ "${blocked}" -eq 1 ]; then
  cat >&2 <<MSG

  ✋ pre-push blocked: you are pushing directly to '${protected}' (this repo's protected branch).

  Why this is blocked:
    • merge is ฟีม's decision — even a one-line doc/ledger change goes through a PR
    • main = production deploy; a direct push deploys without anyone reviewing it

  Do this instead:
    git switch -c feat/your-change            # put your commit(s) on a branch
    git push -u ${remote} feat/your-change    # push the branch (this is allowed)
    gh pr create                              # open a PR → ฟีม merges

  (This is a guard, not a wall: 'git push --no-verify' bypasses it. Follow the PR rule anyway.)

MSG
  exit 1
fi

# ── guard B · hard gate (lint + test) ─────────────────────────────────────────────────────────
if [ "${has_content}" -eq 0 ]; then
  echo "pre-push: nothing being sent (delete / already up-to-date) — hard gate skipped." >&2
  exit 0
fi

# §fail direction — guard A fails OPEN, guard B fails CLOSED. This asymmetry is deliberate:
#   guard A protects against a MISTAKE. If it cannot tell whether you are making that mistake, blocking
#     you would be worse than letting you through — you still have the PR rule.
#   guard B asserts a FACT ("lint and test are green here"). If it cannot run the check, it has no fact
#     to assert. Passing would announce green without anything having been measured — exactly the shape
#     this whole issue (#318) exists to remove.
# ⇒ do NOT "make the hook consistent" by aligning these two. They answer different questions.
die() { printf '\n  ✋ pre-push blocked: %s\n\n' "$1" >&2; exit 1; }

command -v npm >/dev/null 2>&1 \
  || die "'npm' is not on PATH, so lint/test could not run. Not passing a check that never happened.
     (GUI git clients often have a smaller PATH than your shell — launch from a terminal, or fix the client's PATH.)"

echo "pre-push: hard gate → npm run lint" >&2
npm run lint \
  || die "'npm run lint' failed (or the 'lint' script is missing). Fix it, then push again."

echo "pre-push: hard gate → npm test" >&2
# `&& rc=0 || rc=$?`: a bare `x=$(cmd)` under `set -e` (line 31) exits the hook with CMD's own status,
#   so a red test would leave with npm's code instead of reaching die() and its message — and guard B's
#   contract is "fail CLOSED with 1". Caught by scripts/pre-push-guard.test.ts ("fails CLOSED when test is red").
test_out=$(npm test 2>&1) && test_rc=0 || test_rc=$?
printf '%s\n' "$test_out" >&2
[ "$test_rc" -eq 0 ] \
  || die "'npm test' failed (or the 'test' script is missing). Fix it, then push again."

# §skips are LOUD. vitest prints "N skipped" in a summary line that scrolls past; a spec gated behind an
# env var (push-concurrency needs TEST_DATABASE_URL) then never runs and nobody notices — the same shape
# as the 74 files this lane exists to recover (#334 / ตู๋'s N3 on #332).
# `|| true`: with `set -o pipefail` (line 31) a grep that matches NOTHING returns 1 and kills the hook.
#   That is the normal case — most runs skip nothing. Caught by scripts/pre-push-guard.test.ts.
skipped=$(printf '%s\n' "$test_out" | grep -oE '[0-9]+ skipped' | head -1 || true)
if [ -n "$skipped" ]; then
  echo "pre-push: ⚠️  vitest รายงาน $skipped — ด่านเหล่านั้น 'ไม่ได้วิ่ง' ไม่ใช่ 'ผ่าน'" >&2
  printf '%s\n' "$test_out" | grep -E '^\s*[↓→]|skipped' | head -5 >&2 || true
  echo "pre-push:    ถ้ามันคือด่านของสิ่งที่คุณเพิ่งแก้ ไปรันมันจริงแล้วแปะ output ลง PR" >&2
fi

# §lane 2 — the 74 plain node:assert scripts that `npm test` does NOT see.
#   vitest runs ONLY the specs named in vitest.config.mts `include` (27 files). The other
#   scripts/*.test.ts are plain node:assert scripts that used to run in ci.yml's tsx lane — and #321
#   moved ci.yml into .github/workflows/archive/, so from 2026-08-18 13:56Z NOTHING ran them.
#   `npm test` stayed green the whole time: it was green about a pile that had shrunk ~3x, and nothing
#   said so. That is the exact failure this hook exists to prevent, so the lane moves here (#334).
#   The skip list mirrors ci.yml's: those two ARE in vitest's include, so running them twice is waste.
#   ⚠️ ANY new scripts/*.test.ts is picked up automatically — this is a glob, not a hand-synced list.
#      (contrast vitest.config.mts, which IS hand-synced — that is tracked debt #212.)
#   §scope — the lane only claims anything about repos that HAVE this pile. A repo with no scripts/
#   directory (every oracle vault) has no node:assert tests, so "0 files ran" is the truth there, not a
#   broken glob. Where scripts/ DOES exist, 0 matches means the glob broke and we must not call that green.
if [ ! -d scripts ]; then
  echo "pre-push: no scripts/ directory — tsx lane not applicable in this repo" >&2
  echo "pre-push: hard gate green (lint + test). 'npm run build' is still yours to run before opening the PR." >&2
  exit 0
fi

#   §skip list — DERIVED from vitest.config.mts, never hand-copied.
#   The first version of this lane hard-coded the two names ci.yml used to skip. That was already wrong
#   the moment it was written: vitest's include had grown to 32 entries, and a spec that imports from
#   'vitest' CANNOT run under plain tsx. #332 adds five such specs with a .test.ts extension → this glob
#   would grab them → tsx dies → EVERY push in the repo is blocked (มุน caught it by merging all three
#   branches together before any of them landed; each PR was green alone).
#   ⚠️ #333's specs survived only because they end in .tsx — luck, not design.
#   ⇒ one source of truth: whatever vitest claims, this lane skips. That is debt #212 paid on this side.
vitest_specs=$(grep -oE "'scripts/[^']+\.test\.tsx?'" vitest.config.mts 2>/dev/null | tr -d "'" | sort -u)
if [ -z "$vitest_specs" ]; then
  die "could not read the spec list out of vitest.config.mts. Without it this lane cannot tell which
     files vitest already owns, and running a vitest spec under tsx fails for a reason that has nothing
     to do with your change. Fix the parse (or the config), then push again."
fi

echo "pre-push: hard gate → scripts/*.test.ts (tsx lane)" >&2
lane2_failed=0
lane2_ran=0
for f in scripts/*.test.ts; do
  # vitest owns it → `npm test` above already ran it. Running it here would fail on `import … from 'vitest'`.
  if printf '%s\n' "$vitest_specs" | grep -qxF "$f"; then continue; fi
  lane2_ran=$((lane2_ran + 1))
  npx tsx "$f" >/dev/null 2>&1 || { lane2_failed=1; echo "  ✗ $f" >&2; npx tsx "$f" >&2 2>&1 | tail -20; }
done
[ "$lane2_ran" -gt 0 ] \
  || die "the tsx lane matched 0 files. scripts/*.test.ts is where 74 node:assert tests live; matching
     nothing means the glob broke, not that the tests pass. Not asserting green over an empty run."
[ "$lane2_failed" -eq 0 ] \
  || die "a scripts/*.test.ts file failed in the tsx lane (see ✗ above). Fix it, then push again."
echo "pre-push: tsx lane green ($lane2_ran files)" >&2

# §the two guards that went down with ci.yml. #321 archived the workflow that ran these; grep across
#   main-guard.yml · secret-scan.yml · package.json · .githooks/ found no replacement runner (#334).
#   Both are ~1s here, so there is no reason for them to live nowhere.
if [ -f scripts/verify-architecture.ts ]; then
  echo "pre-push: hard gate → verify-architecture" >&2
  npx tsx scripts/verify-architecture.ts \
    || die "'verify-architecture' failed. It used to run in ci.yml (archived by #321) and now runs here."
fi
if [ -f scripts/guard-workflow-integrity.ts ]; then
  echo "pre-push: hard gate → guard-workflow-integrity" >&2
  BASE_REF="${BASE_REF:-origin/main}" npx tsx scripts/guard-workflow-integrity.ts \
    || die "'guard-workflow-integrity' failed — a workflow was deleted or renamed. That is exactly the
     move that made 74 tests stop running on 2026-08-18. If it is deliberate, say so in the PR."
fi

echo "pre-push: hard gate green (lint + test + tsx lane + architecture + workflow-integrity)." >&2
echo "pre-push: 'npm run build' is still yours to run before opening the PR." >&2
exit 0
